<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Dobi" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash window. Extends Theme.SplashScreen so the Android 12+ system
         splash is themed to look like the FIRST FRAME of the splash video.
         Background = avg color of the video's first frame; the icon slot
         is intentionally transparent so no logo is shown before the video. -->
    <style name="Theme.Eduksha.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_video_match</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.Eduksha.SplashContent</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <!-- The splash-phase windowBackground was inheriting white from
             Theme.SplashScreen and showing through in the cutout/nav zones
             around the SurfaceView. Explicitly black so both the splash
             phase and the post-splash phase are consistent. -->
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- windowFullscreen alone only handles the status bar; without
         windowTranslucentNavigation + windowLayoutInDisplayCutoutMode the
         activity is laid out within the area excluding the gesture nav and
         camera cutout, and the splash video shows the white windowBackground
         in those bands instead of extending to the screen edges. -->
    <style name="Theme.Eduksha.SplashContent" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
