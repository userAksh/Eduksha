# Copy this file to keystore.properties (in the repo root) and fill in the
# real values. Never commit keystore.properties or the .jks file itself.
#
# Generate the upload keystore with:
#   keytool -genkey -v -keystore eduksha-upload.jks \
#     -alias eduksha -keyalg RSA -keysize 2048 -validity 10000

storeFile=eduksha-upload.jks
storePassword=CHANGE_ME
keyAlias=eduksha
keyPassword=CHANGE_ME
