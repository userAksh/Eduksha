rules_version = '2';

// Eduksha Firestore rules.
//
// Trust model:
//   - Both parent and child devices authenticate as the parent's uid
//     (the child device signs in with the same Firebase user via the
//     pairing flow). So request.auth.uid is always the parentId.
//   - Each child profile lives at parents/{parentId}/children/{childId}.
//     Top-level activity collections (uploads, quiz_attempts, etc.) carry
//     a `childId` field; they're authorised by checking that the auth.uid
//     owns a child document with that id.
//   - Server-only collections (invites, dobi_meta) deny all client traffic;
//     Cloud Functions reach them via the Admin SDK and bypass rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function isParentOf(childId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/parents/$(request.auth.uid)/children/$(childId));
    }

    match /parents/{parentId} {
      // TEMP: unauthenticated reads allowed for iOS simulator dev (no Firebase Auth on sim)
      // TODO: revert to `request.auth != null && request.auth.uid == parentId` before shipping
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == parentId;

      match /children/{childId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == parentId;
      }
    }

    // Parent-task contracts live in a top-level collection so both the
    // parent and the linked child device can read/write the same doc.
    match /parentTaskRequests/{taskId} {
      // TEMP: unauthenticated reads allowed for iOS simulator dev (no Firebase Auth on sim)
      // TODO: revert to auth-gated read before shipping
      allow read: if true;
      allow write: if request.auth != null
        && resource != null
        && request.auth.uid == resource.data.parentId;
      // Allow the create when the doc is brand-new (resource == null) and
      // the caller claims to be the parent on the new doc.
      allow create: if request.auth != null
        && request.resource.data.parentId == request.auth.uid;
    }

    // Friend invites — server-only. The Admin SDK in Cloud Functions still
    // works because the SDK bypasses these rules entirely.
    match /invites/{code} {
      allow read, write: if false;
    }

    // Daily-news global cache — server-only. Clients call the
    // getDailyNews callable, which returns the cached payload directly.
    match /dobi_meta/{doc} {
      allow read, write: if false;
    }

    // Child-keyed activity collections. The doc must carry a `childId`
    // belonging to the caller.
    // TEMP: unauthenticated reads allowed for iOS simulator dev (no Firebase Auth on sim)
    // TODO: revert to isParentOf(...) reads before shipping
    match /uploads/{id} {
      allow create: if isParentOf(request.resource.data.childId);
      allow read: if true;
      allow update, delete: if isParentOf(resource.data.childId);
    }

    match /homeworks/{id} {
      allow create: if isParentOf(request.resource.data.childId);
      allow read: if true;
      allow update, delete: if isParentOf(resource.data.childId);
    }

    match /subjective_results/{id} {
      allow create: if isParentOf(request.resource.data.childId);
      allow read: if true;
      allow update, delete: if isParentOf(resource.data.childId);
    }

    // quiz_attempts/{childId}/{units|concepts}/{targetId} subtree.
    // The `document=**` recursive wildcard catches every depth under the
    // child id, including the (possibly absent) parent doc itself.
    // TEMP: unauthenticated reads allowed for iOS simulator dev (no Firebase Auth on sim)
    // TODO: revert to isParentOf(childId) reads before shipping
    match /quiz_attempts/{childId} {
      allow read: if true;
      allow write: if isParentOf(childId);
    }
    match /quiz_attempts/{childId}/{document=**} {
      allow read: if true;
      allow write: if isParentOf(childId);
    }

    // Curriculum content: read-only for any signed-in user. Seeding is
    // admin-only via Firebase Console / Admin SDK (which bypasses rules).
    // TEMP: unauthenticated reads allowed for iOS simulator dev (no Firebase Auth on sim)
    // TODO: revert to `request.auth != null` before shipping
    match /concepts/{conceptId} {
      allow read: if true;
      allow write: if false;
    }

    // Child-keyed activity: doc carries a `childId` field; only the
    // owning parent can touch it. Mirrors uploads/homeworks pattern.
    match /completions/{id} {
      allow create: if isParentOf(request.resource.data.childId);
      allow read, update, delete: if isParentOf(resource.data.childId);
    }

    match /revision_marks/{docId} {
      // resource is null when the doc doesn't exist yet. Allow authenticated
      // reads on non-existent docs so toggle()'s existence-check get() and
      // snapshot listeners on new docs don't get a permission error.
      allow read: if request.auth != null
                  && (resource == null || isParentOf(resource.data.childId));
      allow create: if isParentOf(request.resource.data.childId);
      allow update, delete: if isParentOf(resource.data.childId);
    }

    // Subscription status — each user can read/write their own doc.
    // Cloud Functions (webhook) also write here via Admin SDK.
    match /subscriptions/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Pre-launch waitlist signups from the marketing site (eduksha.in).
    // Anyone may create a waitlist entry; reads/updates/deletes are admin-only
    // (handled via Firebase Console or future Cloud Function).
    // Schema is locked down to prevent injection of unrelated fields.
    match /waitlist/{docId} {
      // Two entry points: hero form (phone only, email blank) and bottom
      // form (all four fields). Email and phone are individually optional;
      // at least one must be present and valid.
      allow create: if request.resource.data.keys().hasOnly(['parentName','phone','email','childClass','locale','source','createdAt'])
                    && request.resource.data.parentName is string
                    && request.resource.data.parentName.size() <= 60
                    && request.resource.data.phone is string
                    && (request.resource.data.phone.size() == 0
                        || request.resource.data.phone.matches('^[6-9][0-9]{9}$'))
                    && request.resource.data.email is string
                    && request.resource.data.email.size() < 100
                    && (request.resource.data.email.size() == 0
                        || (request.resource.data.email.size() > 5
                            && request.resource.data.email.matches('.+@.+[.].+')))
                    && (request.resource.data.phone.size() > 0
                        || request.resource.data.email.size() > 0)
                    && request.resource.data.childClass is string
                    && request.resource.data.childClass.size() < 30
                    && request.resource.data.locale in ['en', 'hi']
                    && request.resource.data.source is string
                    && request.resource.data.source.size() < 200
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
  }
}
