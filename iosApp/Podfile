platform :ios, '16.0'
use_frameworks!

target 'iosApp' do
  # shared KMP framework — generated by ./gradlew podInstall from the project root
  pod 'shared', :path => '../shared'

  pod 'Firebase/Auth'
  pod 'Firebase/Firestore'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 16.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      end
      # Kotlin/Native 2.0.x can't parse iOS 26 SDK headers — skip syncFramework
      # and use the pre-built dummy framework instead.
      if target.name == 'shared'
        config.build_settings['OVERRIDE_KOTLIN_BUILD_IDE_SUPPORTED'] = 'YES'
      end
    end
  end
end
